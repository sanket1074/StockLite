# StockLite Server Configuration
PORT=5000

# Local MongoDB URI or MongoDB Atlas Connection String:
# Example Local: mongodb://127.0.0.1:27017/stocklite
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stocklite?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/stocklite
